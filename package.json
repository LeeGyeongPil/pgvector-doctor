{
  "name": "pgvector-doctor",
  "version": "0.3.0",
  "description": "Measure pgvector HNSW recall against exact search for your own filtered SQL, catch fake 100% recall from seq scans, and pick the cheapest ef_search / iterative_scan setting.",
  "type": "module",
  "license": "MIT",
  "author": "LeeGyeongPil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeGyeongPil/pgvector-doctor.git"
  },
  "homepage": "https://github.com/LeeGyeongPil/pgvector-doctor#readme",
  "bugs": {
    "url": "https://github.com/LeeGyeongPil/pgvector-doctor/issues"
  },
  "keywords": [
    "pgvector",
    "postgres",
    "hnsw",
    "recall",
    "vector-search",
    "rag",
    "iterative-scan",
    "cli"
  ],
  "bin": {
    "pgvector-doctor": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/cli.js demo",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:pack": "npm run build && node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-pgvector": "0.0.17",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
